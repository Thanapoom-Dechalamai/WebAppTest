@model RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "สมัครสมาชิก";
}
<section class="auth-card card border-0 w-100 register-page" aria-labelledby="page-title">
    <figure class="auth-photo" aria-hidden="true"><img src="/images/hotels/th-stay-021.jpg" alt="" onerror="this.onerror=null;this.src='/images/stay/photo-pending.svg'" /></figure>

    <div class="auth-panel card-body">
        <div class="auth-brand-logo mb-3">
            <a asp-controller="Account" asp-action="Index" aria-label="Lodgo หน้าแรก">
                <img src="~/images/logo.png" alt="Lodgo" class="auth-logo" height="42" />
            </a>
        </div>
        <h1 id="page-title" class="mb-2">เริ่มต้นบัญชีของคุณ</h1>
        <p class="page-intro mb-4">สมัครสมาชิก เพื่อเริ่มต้นวันพักผ่อนครั้งใหม่</p>
        <form asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>
            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" required maxlength="80" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" required maxlength="80" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input title="@EmailRules.Message" type="email" asp-for="Email" class="form-control" placeholder="example@email.com" autocomplete="email" required aria-describedby="email-error" />
                <span asp-validation-for="Email" id="email-error" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="อย่างน้อย 6 ตัวอักษร" autocomplete="new-password" required aria-describedby="password-error" />
                <span asp-validation-for="Password" id="password-error" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="ยืนยันรหัสผ่าน" autocomplete="new-password" required aria-describedby="confirm-error" />
                <span asp-validation-for="ConfirmPassword" id="confirm-error" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">สมัครสมาชิก</button>
            <div class="account-divider my-3"><span>มีบัญชีอยู่แล้ว?</span></div>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary w-100">กลับไปเข้าสู่ระบบ</a>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


