@{ Layout = "_StayLayout"; ViewData["Title"] = "ช่วยเหลือ"; var signedIn = User.Identity?.IsAuthenticated == true; }
<section class="stay-container commerce-page help-page">
    <h1>ช่วยเหลือ</h1>
    <p class="lead-note">ดูวิธีขอใบเสนอราคา ชำระเงิน และขอแก้ไขการจอง ถ้าต้องการให้เจ้าหน้าที่ช่วย เปิดแชตจากหน้าการจองหรือหน้าแจ้งปัญหาได้</p>

    <nav class="help-links" aria-label="ไปยังหน้าที่ใช้บ่อย">
        <a class="surface" href="/Stays/Bookings"><strong>การจองของฉัน</strong><span>ดูสถานะ พิมพ์ใบยืนยัน และติดต่อเจ้าหน้าที่</span></a>
        <a class="surface" href="/Member/Wallet"><strong>เครดิต</strong><span>เติมเครดิตและดูประวัติ</span></a>
        <a class="surface" href="/Customer/Promotions"><strong>โปรโมชั่น</strong><span>โค้ดส่วนลดที่ใช้ได้ตอนนี้</span></a>
        <a class="surface" href="/Support"><strong>แจ้งปัญหา</strong><span>ส่งเรื่องถึง Lodgo support</span></a>
    </nav>

    <section class="help-section" aria-labelledby="help-flow">
        <h2 id="help-flow">ขั้นตอนการจอง</h2>
        <ol class="help-steps">
            <li><strong>ส่งคำขอจอง</strong><span>เลือกที่พัก ห้อง วันที่ และจำนวนผู้เข้าพัก วันเช็กอินเร็วที่สุดคือวันพรุ่งนี้ กด “ติดต่อเจ้าหน้าที่เพื่อจอง” แล้วส่งคำขอในแชต</span></li>
            <li><strong>เจ้าหน้าที่ส่งใบเสนอราคา</strong><span>เจ้าหน้าที่ตรวจราคาและห้องว่าง แล้วส่งใบเสนอราคาในแชต ห้องยังไม่ถูกกันไว้ และยังไม่มีการหักเครดิต</span></li>
            <li><strong>ยืนยันและชำระ</strong><span>ตรวจรายละเอียด เลือกเครดิตหรือโอนเงิน แล้วกดยืนยันในแชต หรือกดไม่รับใบเสนอราคา ยืนยันได้ภายใน 24 ชั่วโมงหลังส่งหรือก่อนถึงวันเช็กอิน ขึ้นอยู่กับว่าเวลาไหนมาถึงก่อน</span></li>
            <li><strong>ฝ่ายบัญชี Lodgo ตรวจการชำระเงิน</strong><span>ทุกการจองผ่านขั้นนี้ก่อน ถ้าไม่ผ่าน คุณได้รับแจ้งพร้อมเหตุผล</span></li>
            <li><strong>โรงแรมยืนยันห้อง</strong><span>พนักงานโรงแรมตรวจห้องว่างแล้วกดยืนยัน คุณได้รับการแจ้งเตือน</span></li>
            <li><strong>เช็กอินและเช็กเอาต์</strong><span>แจ้งหมายเลขการจอง (LG ตามด้วยตัวเลข) ที่แผนกต้อนรับ</span></li>
            <li><strong>รีวิว</strong><span>หลังโรงแรมบันทึกเช็กเอาต์ เขียนรีวิวได้จากหน้าที่พักหรือหน้าการจอง</span></li>
        </ol>
    </section>

    <section class="help-section" aria-labelledby="help-pay">
        <h2 id="help-pay">การชำระเงินและโค้ดส่วนลด</h2>
        <div class="faq-list">
            <details open><summary>จ่ายได้กี่แบบ</summary><p>เลือกได้ตอนยืนยันใบเสนอราคาในแชต <strong>เครดิต Lodgo</strong> จะถูกหักเมื่อยืนยันสำเร็จ หากเลือก <strong>โอนเงินเข้าบัญชี Lodgo</strong> ให้แนบสลิป (JPG, PNG หรือ PDF ไม่เกิน 5 MB) หรือกรอกเลขที่รายการอย่างน้อยหนึ่งอย่าง ทั้งสองแบบรอฝ่ายบัญชีตรวจก่อนส่งถึงโรงแรม</p></details>
            <details><summary>เติมเครดิตอย่างไร</summary><p>เปิดหน้า <a href="/Member/Wallet">เครดิต</a> เติมได้ครั้งละ 100–50,000 บาท ยอดคงเหลือแสดงที่มุมขวาบนของเว็บ เครดิตในเว็บนี้ใช้สำหรับทดลองระบบ ไม่มีการตัดเงินจากธนาคาร</p></details>
            <details><summary>โอนเงินแล้วรอนานไหม</summary><p>รายการอยู่ในสถานะ "รอตรวจการชำระเงิน" จนกว่าฝ่ายบัญชีจะตรวจ แต่ละบัญชีมีรายการโอนเงินรอตรวจได้พร้อมกันไม่เกิน 3 รายการ</p></details>
            <details><summary>ใช้โค้ดส่วนลดอย่างไร</summary><p>กด “ใช้โค้ดนี้” ที่หน้า <a href="/Customer/Promotions">โปรโมชั่น</a> ก่อนเลือกห้อง หรือแจ้งโค้ดให้เจ้าหน้าที่ในแชตก่อนออกใบเสนอราคา ตรวจส่วนลดและยอดชำระบนใบเสนอราคาก่อนยืนยัน แต่ละโค้ดมีเงื่อนไขการใช้ต่างกัน</p></details>
        </div>
    </section>

    <section class="help-section" aria-labelledby="help-cancel">
        <h2 id="help-cancel">ยกเลิกและเงินคืน</h2>
        <div class="faq-list">
            <details><summary>ขอยกเลิกได้ถึงเมื่อไร</summary><p>เปิดหน้ารายละเอียดการจองแล้วกด “แชตกับเจ้าหน้าที่เรื่องการจองนี้” เพื่อขอยกเลิกก่อนวันเช็กอิน เจ้าหน้าที่จะตรวจเงื่อนไขและดำเนินการให้ ระบบคืนยอดที่รับชำระแล้วเป็นเครดิต</p></details>
            <details><summary>ถ้าโรงแรมหรือฝ่ายบัญชีปฏิเสธ</summary><p>ระบบคืนยอดที่รับชำระแล้วเป็นเครดิตและคืนสิทธิ์โค้ดส่วนลด การโอนเงินที่ยังไม่ผ่านการตรวจจะไม่มีเครดิตคืน</p></details>
            <details><summary>ถึงวันเข้าพักแล้วรายการยังรออยู่</summary><p>ถ้ายังรอตรวจการชำระเงินหรือรอโรงแรมยืนยันเมื่อถึงวันเช็กอิน ระบบจะยกเลิกและคืนยอดที่รับชำระแล้วเป็นเครดิต</p></details>
            <details><summary>ไม่ได้ไปเข้าพักในรายการที่ยืนยันแล้ว</summary><p>ถ้าไม่มีการเช็กอินจนถึงวันเช็กเอาต์ ระบบจะปิดรายการเป็นไม่มาเข้าพักและไม่คืนเครดิต</p></details>
        </div>
    </section>

    <section class="help-section" aria-labelledby="help-more">
        <h2 id="help-more">ระหว่างจองและบัญชีของคุณ</h2>
        <div class="faq-list">
            <details><summary>บอกความต้องการพิเศษกับโรงแรม</summary><p>ใส่ “คำขอพิเศษ” ตอนเลือกห้องได้ไม่เกิน 300 ตัวอักษร หรือแจ้งเจ้าหน้าที่ในแชต ตรวจว่าคำขออยู่ในใบเสนอราคาก่อนยืนยัน โรงแรมจะเห็นในรายการจองและใบยืนยัน</p></details>
            <details><summary>เก็บที่พักไว้ดูทีหลัง</summary><p>กดรูปหัวใจบนการ์ดหรือหน้าที่พัก ที่พักจะอยู่ใน <a href="/Wishlist">รายการโปรด</a> กดหัวใจอีกครั้งเพื่อเอาออก</p></details>
            <details><summary>พิมพ์ใบยืนยันการจอง</summary><p>เปิดการจองแล้วกด "พิมพ์ใบยืนยันการจอง" ใบยืนยันมีหมายเลขการจอง วันที่ และคำขอพิเศษ</p></details>
            <details><summary>แก้ชื่อ รูปโปรไฟล์ หรือรหัสผ่าน</summary><p>เปิด <a href="/Member/Profile">ข้อมูลบัญชี</a> แก้ชื่อและรูปโปรไฟล์ แล้วเปลี่ยนรหัสผ่านได้ในหน้าเดียวกัน</p></details>
            <details><summary>ติดต่อ Lodgo support</summary><p>กด “แชตกับเจ้าหน้าที่เรื่องการจองนี้” ในหน้าการจอง หรือเปิดหน้า <a href="/Support">แจ้งปัญหา</a> เมื่อเจ้าหน้าที่ตอบ จะมีการแจ้งเตือนที่รูปกระดิ่ง</p></details>
        </div>
    </section>
    @if (!signedIn) { <p class="help-signin">ยังไม่มีบัญชี <a asp-controller="Account" asp-action="Register">สมัครสมาชิก</a> หรือ <a asp-controller="Account" asp-action="Login">เข้าสู่ระบบ</a> เพื่อจองและดูการจองของคุณ</p> }
</section>
