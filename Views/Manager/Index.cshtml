@model UserListViewModel
@inject Nontiwat_7362_L002.Services.TodayService TodayPanel
@{Layout="_StayLayout";ViewData["Title"]="Manager · จัดการทีม";var roles=User.IsInRole(AppRoles.Admin)?AppRoles.All:AppRoles.TeamRoles;var ownId=User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;}
<section class="stay-container commerce-page"><partial name="_RoleNavigation" /><h1>จัดการบัญชีทีมงาน</h1><p class="lead-note">Manager จัดการบทบาท Customer และ Staff (Lodgo support) ได้ บทบาทอื่นรวมถึง AC (ฝ่ายบัญชี) และพนักงานโรงแรมให้ Admin จัดการ · แสดงสูงสุด 200 บัญชี</p>
@await Html.PartialAsync("_TodayPanel", await TodayPanel.ForAsync(User))
<partial name="_CommerceMessage" />
<div class="role-toolbar"><a class="stay-button" asp-action="AddEmployee">+ เพิ่มบัญชีทีมงาน</a><a class="stay-button secondary" asp-action="Promotions">จัดการโปรโมชั่น</a><a class="stay-button secondary" href="/HotelRequests">คำขอสิทธิ์ดูแลโรงแรม</a><a class="stay-button secondary" href="/Manager/Kpi">ดู KPI การจอง</a></div>
<form method="get" class="role-filter"><label>ค้นหาชื่อหรืออีเมล<input name="search" value="@Model.Search" maxlength="100" /></label><button class="stay-button" type="submit">ค้นหา</button></form>
<div class="surface table-scroll"><table class="ledger-table"><thead><tr><th>ชื่อ</th><th>อีเมล</th><th>บทบาทปัจจุบัน</th><th>กำหนดบทบาท</th></tr></thead><tbody>@foreach(var person in Model.Users){<tr><td>@person.FirstName @person.LastName</td><td>@person.Email</td><td>@AppRoles.Label(person.Role)</td><td>@if(person.Id.ToString()!=ownId){<form asp-action="ChangeRole" method="post" class="role-inline"><input name="Id" type="hidden" value="@person.Id" /><label class="visually-hidden" for="role-@person.Id">บทบาทของ @person.Email</label><select id="role-@person.Id" name="Role">@foreach(var role in roles){<option value="@role" selected="@(person.Role==role)">@AppRoles.Label(role)</option>}</select><button class="stay-button secondary" type="submit">บันทึก</button></form>}else{<span>บัญชีของคุณ</span>}</td></tr>}@if(Model.Users.Count==0){<tr><td colspan="4">ไม่พบบัญชี</td></tr>}</tbody></table></div></section>