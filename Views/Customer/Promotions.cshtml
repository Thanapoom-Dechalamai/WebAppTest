@model IReadOnlyList<Promotion>
@{
    Layout = "_StayLayout"; ViewData["Title"] = "โปรโมชั่น";
    var used = ViewData["UsedPromotions"] as List<int> ?? new();
    var codes = Model.Where(x => x.Code is not null).ToList();
    var news = Model.Where(x => x.Code is null).ToList();
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
@* Promotions (2026-11-22): discount codes as tickets of equal height, news in its own section below *@
<section class="stay-container commerce-page promo-page">
    <h1>ทริปที่ใช่ ในราคาที่ดีขึ้น</h1>
    <p class="lead-note">เลือกโค้ดที่เหมาะกับทริป แล้วใส่ในหน้าชำระเงิน ระบบแสดงยอดก่อนลดและยอดหลังลดก่อนยืนยัน</p>
    @if (Model.Count == 0) { <div class="surface empty-note"><h2>ยังไม่มีโปรโมชั่นที่เปิดอยู่</h2><p>กลับมาดูข้อเสนอใหม่ได้ในภายหลัง</p></div> }

    @if (codes.Count > 0) {
        <section class="promo-section" aria-labelledby="codes-title">
            <div class="promo-head"><h2 id="codes-title">โค้ดส่วนลด</h2><p class="muted">แต่ละโค้ดใช้ได้ 1 ครั้งต่อบัญชี · ยกเลิกการจองเองแล้วไม่คืนสิทธิ์โค้ด</p></div>
            <ul class="coupon-grid">
                @foreach (var p in codes) {
                    var isUsed = used.Contains(p.Id);
                    var percent = p.DiscountKind == "Percent";
                    <li class="promo-ticket @(isUsed ? "is-used" : "")">
                        <div class="coupon-value" aria-hidden="true">
                            <strong>@(percent ? p.DiscountValue.ToString("0.##", inv) + "%" : "฿" + p.DiscountValue.ToString("N0", inv))</strong>
                            <span>ส่วนลด</span>
                            @if (p.MaxDiscount is > 0) { <small>สูงสุด ฿@p.MaxDiscount.Value.ToString("N0", inv)</small> }
                        </div>
                        <div class="coupon-body">
                            <h3>@p.Title</h3>
                            <p class="visually-hidden">@p.Terms</p>
                            <ul class="coupon-terms" aria-label="เงื่อนไข">
                                <li>พักขั้นต่ำ @p.MinNights คืน</li>
                                @if (p.MinSpend > 0) { <li>ยอดขั้นต่ำ ฿@p.MinSpend.ToString("N0", inv)</li> }
                                <li>1 ครั้งต่อบัญชี</li>
                            </ul>
                            <p class="coupon-expiry">ใช้ได้ถึง @ThaiDates.Long(p.EndsOn)</p>
                            <div class="coupon-actions">
                                @if (isUsed) {
                                    <span class="pill coupon-used">บัญชีนี้ใช้โค้ดนี้แล้ว</span>
                                } else {
                                    <span class="coupon-code"><code>@p.Code</code><button type="button" class="copy-code" data-code="@p.Code" aria-label="คัดลอกโค้ด @p.Code">คัดลอก</button></span>
                                    <a class="stay-button" href="/Stays?promo=@Uri.EscapeDataString(p.Code!)">ใช้โค้ดนี้<span class="visually-hidden"> @p.Code เลือกที่พัก</span></a>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ul>
            <p class="copy-status visually-hidden" aria-live="polite"></p>
        </section>
    }

    @if (news.Count > 0) {
        <section class="promo-section" aria-labelledby="news-title">
            <div class="promo-head"><h2 id="news-title">ข่าวสารจาก Lodgo</h2><p class="muted">ข้อเสนอที่ไม่ต้องใช้โค้ด</p></div>
            <ul class="news-grid">
                @foreach (var p in news) {
                    <li class="news-card">
                        <p class="news-date">ถึง @ThaiDates.Long(p.EndsOn)</p>
                        <h3>@p.Title</h3>
                        <p>@p.Details</p>
                    </li>
                }
            </ul>
        </section>
    }
</section>
<script>
    // Copy a code to the clipboard; the button says so, and a hidden live region tells screen readers.
    document.querySelectorAll('.copy-code').forEach(b => b.addEventListener('click', async () => {
        const status = document.querySelector('.copy-status');
        try { await navigator.clipboard.writeText(b.dataset.code); } catch { return; }
        const was = b.textContent; b.textContent = 'คัดลอกแล้ว'; if (status) status.textContent = 'คัดลอกโค้ด ' + b.dataset.code + ' แล้ว';
        setTimeout(() => { b.textContent = was; }, 1600);
    }));
</script>
