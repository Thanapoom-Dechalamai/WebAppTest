@model HotelRoomForm
@{
    Layout = "_StayLayout";
    var hotelId = ViewContext.RouteData.Values["id"];
    var roomId = Context.Request.Query["roomId"].ToString();
    ViewData["Title"] = string.IsNullOrEmpty(roomId) ? "เพิ่มประเภทห้อง" : "แก้ไขประเภทห้อง";
}
<section class="stay-container commerce-page">
    <h1>@ViewData["Title"] · @ViewData["HotelName"]</h1>
    <form class="surface form-stack hotel-catalog-editor" method="post" asp-action="Edit" asp-route-id="@hotelId" asp-route-roomId="@roomId">
        <div asp-validation-summary="ModelOnly" class="validation-errors"></div>
        <div><label asp-for="Name"></label><input asp-for="Name" required /><span asp-validation-for="Name" class="field-error"></span></div>
        <div><label asp-for="Price"></label><input asp-for="Price" type="number" min="1" step="0.01" required /><span asp-validation-for="Price" class="field-error"></span></div>
        <div>
            <label asp-for="Capacity"></label><input asp-for="Capacity" type="number" min="0" max="@RoomCapacity.Max" required aria-describedby="capacity-hint" />
            <small id="capacity-hint">จำนวนเฉพาะวันที่ตั้งไว้ในปฏิทินห้องว่างมีผลเหนือจำนวนปกติ</small>
            <span asp-validation-for="Capacity" class="field-error"></span>
        </div>
        <div><label asp-for="SizeSquareMeters"></label><input asp-for="SizeSquareMeters" type="number" min="1" /><span asp-validation-for="SizeSquareMeters" class="field-error"></span></div>
        <div><label asp-for="BedType"></label><input asp-for="BedType" /><span asp-validation-for="BedType" class="field-error"></span></div>
        <div><label asp-for="BedCount"></label><input asp-for="BedCount" type="number" min="1" max="20" /><span asp-validation-for="BedCount" class="field-error"></span></div>
        <div><label asp-for="Features"></label><textarea asp-for="Features" rows="4"></textarea><span asp-validation-for="Features" class="field-error"></span></div>
        <label class="role-checkbox hotel-catalog-publish"><input asp-for="IsActive" /><span>เปิดขายห้องประเภทนี้</span></label>
        <div class="role-inline">
            <button class="stay-button" type="submit">บันทึก</button>
            <a class="stay-button secondary" asp-action="Index" asp-route-id="@hotelId">กลับหน้าประเภทห้อง</a>
        </div>
    </form>
</section>
