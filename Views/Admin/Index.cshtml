@inject Nontiwat_7362_L002.Services.TodayService TodayPanel
@{ Layout="_StayLayout"; ViewData["Title"]="Admin · แผงควบคุม"; }
<section class="stay-container commerce-page"><partial name="_RoleNavigation" /><h1>จัดการระบบ Lodgo</h1><p class="lead-note">จัดการบัญชีและสิทธิ์ทั้ง 7 บทบาท รวมถึงส่วนงานการจอง โปรโมชั่น และรายงาน</p>
@await Html.PartialAsync("_TodayPanel", await TodayPanel.ForAsync(User))

<div class="role-actions"><a class="surface" asp-controller="HotelManagement" asp-action="Index"><h2>พนักงานโรงแรม</h2><p>กำหนดโรงแรมที่แต่ละบัญชีดูแล และค่าธรรมเนียมของแต่ละโรงแรม</p></a><a class="surface" href="/HotelRequests"><h2>คำขอสิทธิ์ดูแลโรงแรม</h2><p>ตรวจหลักฐานจากพนักงานโรงแรม แล้วอนุมัติ</p></a><a class="surface" asp-controller="HotelOwner" asp-action="Index"><h2>ยืนยันห้องพัก</h2><p>ดูรายการรอยืนยันและยอดรับของโรงแรม</p></a><a class="surface" asp-action="UserList"><h2>บัญชีและบทบาท</h2><p>เพิ่ม แก้ไข และกำหนดสิทธิ์ผู้ใช้งาน</p></a><a class="surface" asp-controller="Staff" asp-action="Index"><h2>รายการจองทั้งหมด</h2><p>ช่วยเหลือลูกค้าและยกเลิกรายการ</p></a><a class="surface" asp-controller="Manager" asp-action="Promotions"><h2>โปรโมชั่น</h2><p>เพิ่ม แก้ไข และปิดประกาศ</p></a><a class="surface" asp-controller="Owner" asp-action="Index"><h2>ภาพรวมระบบ</h2><p>สมาชิก ที่พัก และยอดการจอง</p></a><a class="surface" asp-controller="AC" asp-action="Index"><h2>รายงานบัญชี</h2><p>ยอดชำระ คืนเครดิต และเติมเครดิตจำลอง</p></a><a class="surface" asp-action="AuditLogs"><h2>ประวัติการใช้งานระบบ</h2><p>ใครแก้ข้อมูลอะไร เมื่อไร ค้นหาตามผู้ใช้ ตาราง และวันที่</p></a><a class="surface" asp-controller="HotelOwner" asp-action="Calendar"><h2>ปฏิทินห้องว่าง</h2><p>จำนวนห้องที่เปิดขายและวันปิดรับจองของทุกโรงแรม</p></a></div></section>