@using System.Security.Claims
@{
    var accountId = User.Identity?.IsAuthenticated == true
        ? User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "" : "";
}
<meta name="lodgo-account" content="@accountId" data-session-url="@Url.Action("SessionStatus", "Account")" />
<script src="~/js/account-context.js" asp-append-version="true" defer></script>
