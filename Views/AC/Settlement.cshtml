@model SettlementPage
@{Layout="_StayLayout";ViewData["Title"]="AC · สรุปยอดโรงแรม";}
<section class="stay-container commerce-page"><partial name="_RoleNavigation" /><h1>สรุปยอดและโอนให้โรงแรม</h1>
<p class="lead-note">นับตั้งแต่ลูกค้าเช็กอิน (รวมเข้าพักเสร็จ และลูกค้าไม่มา) เพราะคืนเงินลูกค้าไม่ได้แล้ว · Lodgo หักค่าคอมมิชชั่น ตามอัตราที่ล็อกไว้ในแต่ละการจอง (ค่าเริ่มต้น @FinanceRules.CommissionPercent.ToString("0.##")%) ที่เหลือเป็นยอดที่ต้องโอนให้โรงแรม · กดชื่อโรงแรมเพื่อดูว่าเงินมาจากการจองไหน ใครจ่าย จ่ายเมื่อไร</p>
<partial name="_ACTabs" /><partial name="_CommerceMessage" />
<p class="download-row"><a class="stay-button secondary download-button" href="/AC/Export?kind=settlement"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> ดาวน์โหลด CSV สรุปรายโรงแรม (ยอดสะสม)</a></p>
<ol class="money-flow" aria-label="เส้นทางของเงิน"><li><strong>ลูกค้าจ่ายค่าจอง</strong><span>หักเครดิต หรือโอนเงินแนบสลิปให้ Staff ตรวจ · Lodgo ถือไว้</span></li><li><strong>โรงแรมยืนยันห้อง</strong><span>ยังยกเลิกและคืนเงินได้</span></li><li><strong>ลูกค้าเช็กอิน</strong><span>เป็นรายได้ คืนไม่ได้แล้ว</span></li><li><strong>หักคอมมิชชั่นตามอัตราของการจอง</strong><span>เป็นรายได้ของ Lodgo</span></li><li><strong>AC โอนให้โรงแรม</strong><span>บันทึกวิธีโอนและเลขอ้างอิง</span></li></ol>
<div class="role-metrics"><div class="surface"><span>ค้างโอนให้โรงแรมทั้งหมด</span><strong>฿@(Model.Hotels.Sum(x=>x.Outstanding).ToString("N2"))</strong></div><div class="surface"><span>โอนให้โรงแรมแล้ว</span><strong>฿@(Model.Hotels.Sum(x=>x.Paid).ToString("N2"))</strong></div><div class="surface"><span>ค่าคอมมิชชั่นของ Lodgo</span><strong>฿@(Model.Hotels.Sum(x=>x.Commission).ToString("N2"))</strong></div><div class="surface"><span>ยอดยืนยันแล้ว ยังไม่ถึงรอบโอน</span><strong>฿@(Model.Hotels.Sum(x=>x.Upcoming).ToString("N2"))</strong></div></div>
<div class="surface table-scroll"><table class="ledger-table"><thead><tr><th>โรงแรม</th><th>เช็กอินแล้ว</th><th>คอมมิชชั่น</th><th>ต้องโอน</th><th>โอนแล้ว</th><th>ค้างโอน</th><th></th></tr></thead><tbody>
@foreach(var h in Model.Hotels){<tr><td><a class="hotel-link" asp-action="Statement" asp-route-id="@h.HotelId">@h.HotelName</a><br /><small class="muted">ยืนยันแล้วรอเข้าพัก ฿@h.Upcoming.ToString("N2")</small></td><td>฿@h.Earned.ToString("N2")</td><td class="@(h.Commission>0?"negative":"muted")">@(h.Commission>0?"−฿"+h.Commission.ToString("N2"):"—")</td><td>฿@h.Payable.ToString("N2")</td><td>฿@h.Paid.ToString("N2")</td><td><strong>฿@h.Outstanding.ToString("N2")</strong></td><td><a class="stay-button @(h.Outstanding>0?"":"secondary") small-button" asp-action="Statement" asp-route-id="@h.HotelId">@(h.Outstanding>0?"ดูที่มาและบันทึกการโอน":"ดูที่มาของเงิน")</a></td></tr>}
@if(Model.Hotels.Count==0){<tr><td colspan="7">ยังไม่มีการจองที่ยืนยันหรือเข้าพักจบแล้ว</td></tr>}</tbody></table></div>
<div class="surface table-scroll history-panel"><h2>ประวัติการโอนให้โรงแรม · ล่าสุด 100 รายการ</h2><table class="ledger-table"><thead><tr><th>วันเวลา</th><th>โรงแรม</th><th>วิธีโอน</th><th>เลขอ้างอิง / หมายเหตุ</th><th>บันทึกโดย</th><th>จำนวน</th></tr></thead><tbody>@foreach(var r in Model.Payouts){var p=r.Payout;<tr><td>@p.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td><td><a class="hotel-link" asp-action="Statement" asp-route-id="@p.HotelId">@p.HotelName</a></td><td>@FinanceRules.MethodLabel(p.Method)</td><td>@(p.Reference) @if(!string.IsNullOrEmpty(p.Note)){<br /><small class="muted">@p.Note</small>}</td><td>@r.PaidByEmail</td><td>฿@p.Amount.ToString("N2")</td></tr>}@if(Model.Payouts.Count==0){<tr><td colspan="6">ยังไม่มีการโอน</td></tr>}</tbody></table></div></section>
