@model OwnerDashboard
@inject Nontiwat_7362_L002.Services.TodayService TodayPanel
@using Nontiwat_7362_L002.Services
@{Layout="_StayLayout";ViewData["Title"]="Owner · ภาพรวม";
  var labels = Model.Months.Select(m => ThaiMonth.Short(m.Month)).ToList();
  var revenue = new LineChart("chart-revenue", "รายได้สุทธิรายเดือน (ลูกค้าจ่าย − คืนเครดิต)", labels, Model.Months.Select(m => (double)m.NetRevenue).ToList(), "baht");
  var bookings = new LineChart("chart-bookings", "จำนวนการจองรายเดือน", labels, Model.Months.Select(m => (double)m.Bookings).ToList(), "count");
  var thisMonth = Model.Months.LastOrDefault();}
<section class="stay-container commerce-page owner-dashboard" data-active-months="@Model.ActiveMonths"><partial name="_RoleNavigation" /><h1>ภาพรวมกิจการ</h1><p class="lead-note">สรุปข้อมูลทั้งระบบ · หน้านี้ดูข้อมูลได้อย่างเดียว · นับตามเวลาไทย</p>
@await Html.PartialAsync("_TodayPanel", await TodayPanel.ForAsync(User))

<div class="role-metrics"><div class="surface"><span>ลูกค้า</span><strong>@Model.Customers</strong></div><div class="surface"><span>บัญชีทีมงานและผู้ดูแล</span><strong>@Model.Employees</strong></div><div class="surface"><span>ที่พัก / จังหวัด</span><strong>@Model.Hotels / @Model.Provinces</strong></div><div class="surface"><span>รายการจอง / ยกเลิก</span><strong>@Model.Bookings / @Model.Cancelled</strong></div><div class="surface"><span>ยอดชำระการจอง</span><strong>฿@Model.BookingRevenue.ToString("N2")</strong></div><div class="surface"><span>ยอดคืนเครดิต</span><strong>฿@Model.Refunds.ToString("N2")</strong></div><div class="surface"><span>ยอดจองสุทธิหลังคืนเครดิต</span><strong>฿@((Model.BookingRevenue-Model.Refunds).ToString("N2"))</strong></div></div>

<section class="surface owner-warnings" id="warnings" aria-labelledby="warnings-title">
    <h2 id="warnings-title">สัญญาณเตือน</h2>
    @if (Model.Warnings.Count == 0) { <p class="muted">ไม่มีสัญญาณเตือนตอนนี้ (ตรวจ: อัตรายกเลิกเกิน @OwnerInsights.CancelRateLimit% ที่มีตั้งแต่ @OwnerInsights.CancelMinBookings การจองใน @OwnerInsights.WarningWindowDays วัน, คะแนนรีวิวจริงต่ำกว่า @OwnerInsights.LowRating, คำขอค้างเกิน 24 ชม.)</p> } else {
    <ul class="warning-list">
        @foreach (var w in Model.Warnings) {
            <li class="warning-item warning-@w.Kind"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 3 2 20h20L12 3zm0 6v5m0 3v.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>@w.Text</span>@if (w.Url.Length > 0) { <a href="@w.Url">ดู</a> }</li>
        }
    </ul> }
</section>

<section class="owner-trend" aria-labelledby="trend-title">
    <h2 id="trend-title">แนวโน้ม 12 เดือน</h2>
    @if (Model.ActiveMonths < 4) {
        <div class="trend-cards">
            <div class="surface kpi-card"><span>รายได้สุทธิเดือนนี้</span><strong>฿@((thisMonth?.NetRevenue ?? 0).ToString("N0"))</strong><small>ลูกค้าจ่าย − คืนเครดิต</small></div>
            <div class="surface kpi-card"><span>จำนวนการจองเดือนนี้</span><strong>@(thisMonth?.Bookings ?? 0)</strong><small>ยกเลิก @(thisMonth?.Cancelled ?? 0)</small></div>
            <div class="surface kpi-card"><span>เดือนที่มีข้อมูล</span><strong>@Model.ActiveMonths / 12</strong><small>กราฟจะแสดงเมื่อมีข้อมูลอย่างน้อย 4 เดือน</small></div>
        </div>
    } else {
        <div class="trend-charts"><partial name="_LineChart" model="revenue" /><partial name="_LineChart" model="bookings" /></div>
    }
    <div class="surface table-scroll"><table class="ledger-table month-table">
        <caption class="visually-hidden">ตัวเลขรายเดือน 12 เดือน</caption>
        <thead><tr><th scope="col">เดือน</th><th scope="col">ลูกค้าจ่าย</th><th scope="col">คืนเครดิต</th><th scope="col">รายได้สุทธิ</th><th scope="col">การจอง</th><th scope="col">ยกเลิก</th></tr></thead>
        <tbody>@foreach (var m in Model.Months.Reverse()) { <tr data-month="@ThaiMonth.Key(m.Month)"><th scope="row">@ThaiMonth.Label(m.Month)</th><td>฿@m.Revenue.ToString("N0")</td><td>฿@m.Refunds.ToString("N0")</td><td>฿@m.NetRevenue.ToString("N0")</td><td>@m.Bookings</td><td>@m.Cancelled</td></tr> }</tbody>
    </table></div>
</section>

<div class="kpi-two owner-ranks">
    <div class="surface table-scroll"><h2>ที่พักทำยอดสูงสุด</h2>
        @if (Model.TopHotels.Count == 0) { <p class="muted">ยังไม่มีการจองใน 12 เดือน</p> } else {
        <table class="ledger-table"><thead><tr><th scope="col">ที่พัก</th><th scope="col">การจอง</th><th scope="col">ยอดจอง</th></tr></thead><tbody>
        @foreach (var h in Model.TopHotels) { <tr><td><a href="/Stays/Details/@h.Key">@h.Name</a></td><td>@h.Bookings</td><td>฿@h.Amount.ToString("N0")</td></tr> }
        </tbody></table> }
    </div>
    <div class="surface table-scroll"><h2>จังหวัดทำยอดสูงสุด</h2>
        @if (Model.TopProvinces.Count == 0) { <p class="muted">ยังไม่มีการจองใน 12 เดือน</p> } else {
        <table class="ledger-table"><thead><tr><th scope="col">จังหวัด</th><th scope="col">การจอง</th><th scope="col">ยอดจอง</th></tr></thead><tbody>
        @foreach (var c in Model.TopProvinces) { <tr><td>@c.Name</td><td>@c.Bookings</td><td>฿@c.Amount.ToString("N0")</td></tr> }
        </tbody></table> }
    </div>
</div>
<p class="simulation-box">ยอดทั้งหมดเป็นเครดิตจำลองของระบบ ไม่ใช่รายรับเงินจริงหรือกำไรทางบัญชี · อันดับนับจากยอดการจองที่ไม่ถูกยกเลิกใน 12 เดือน</p></section>
