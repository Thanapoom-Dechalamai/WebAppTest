@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "เข้าสู่ระบบ";
}
<section class="auth-card card border-0 w-100 login-page" aria-labelledby="page-title">
    <figure class="auth-photo" aria-hidden="true"><img src="/images/hotels/th-stay-048.jpg" alt="" onerror="this.onerror=null;this.src='/images/stay/photo-pending.svg'" /></figure>

    <div class="auth-panel card-body">
        <div class="auth-brand-logo mb-3">
            <a asp-controller="Account" asp-action="Index" aria-label="Lodgo หน้าแรก">
                <img src="~/images/logo.png" alt="Lodgo" class="auth-logo" height="42" />
            </a>
        </div>
        <h1 id="page-title" class="mb-2">@(ViewData["SwitchAccount"] is true ? "เปลี่ยนบัญชี" : "ยินดีต้อนรับกลับ")</h1>
        <p class="page-intro mb-4">@(ViewData["SwitchAccount"] is true ? "เข้าสู่ระบบด้วยบัญชีที่ต้องการใช้งาน" : "เข้าสู่ระบบ แล้วไปเลือกวันพักผ่อนที่เป็นของคุณ")</p>
                <form asp-controller="Account" asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="example@email.com" autocomplete="email" required aria-describedby="email-error" />
                <span asp-validation-for="Email" id="email-error" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="รหัสผ่าน" autocomplete="current-password" required aria-describedby="password-error" />
                <span asp-validation-for="Password" id="password-error" class="text-danger small"></span>
            </div>
            <p class="small mb-3"><a asp-controller="Account" asp-action="ForgotPassword">ลืมรหัสผ่าน?</a></p>
            <button type="submit" class="btn btn-primary w-100">เข้าสู่ระบบ</button>
            <div class="account-divider my-3"><span>ยังไม่มีบัญชี?</span></div>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary w-100">สมัครสมาชิก</a>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
