@model IEnumerable<TodoItem>
@{
    ViewData["Title"] = "รายการงานทั้งหมด";
    var total = Model.Count();
    var done = Model.Count(i => i.IsCompleted);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>รายการงานทั้งหมด</h2>
    <span class="badge bg-primary fs-6">เสร็จแล้ว @done / @total</span>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">ยังไม่มีงานในรายการ คลิก "เพิ่มงานใหม่" เพื่อเริ่มต้น</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th style="width: 3rem;"></th>
                <th>ชื่องาน</th>
                <th>รายละเอียด</th>
                <th>กำหนดส่ง</th>
                <th style="width: 12rem;">จัดการ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="@(item.IsCompleted ? "table-secondary" : "")">
                    <td>
                        <form asp-action="ToggleComplete" asp-route-id="@item.Id" method="post">
                            <input type="checkbox" class="form-check-input" checked="@item.IsCompleted"
                                   onchange="this.form.submit()" title="ทำเครื่องหมายว่าเสร็จ/ยังไม่เสร็จ" />
                        </form>
                    </td>
                    <td class="@(item.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                        @item.Title
                    </td>
                    <td class="text-muted">@item.Description</td>
                    <td>
                        @if (item.DueDate != null)
                        {
                            @item.DueDate.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">แก้ไข</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">ลบ</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
