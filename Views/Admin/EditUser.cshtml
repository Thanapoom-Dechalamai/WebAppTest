@model EditUserViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "แก้ไขข้อมูลผู้ใช้";
}
<section class="auth-card card border-0 w-100 adduser-page" aria-labelledby="page-title">
    <div class="auth-panel card-body">
        <h1 id="page-title" class="mb-2">แก้ไขข้อมูลผู้ใช้</h1>
        <p class="page-intro mb-4">รหัสผู้ใช้ #@Model.Id · บันทึกข้อมูลลงฐานข้อมูล MySQL</p>
        <form asp-action="EditUser" method="post" class="adduser-form">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger full-width" role="alert"></div>
            <div class="mb-3">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" required maxlength="80" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" required maxlength="80" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="mb-3 full-width">
                <label asp-for="Email" class="form-label"></label>
                <input title="@EmailRules.Message" asp-for="Email" type="email" class="form-control" required maxlength="254" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3 full-width">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select">@foreach (var role in AppRoles.All) { <option value="@role">@AppRoles.Label(role)</option> }</select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>
            <partial name="_HotelPicker" model="Model" />
            <button type="submit" class="btn btn-primary w-100">บันทึกการแก้ไข</button>
            <a asp-action="UserList" class="btn btn-outline-primary w-100">ยกเลิก</a>
        </form>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }


