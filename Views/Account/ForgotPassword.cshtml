@model ForgotPasswordForm
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "ลืมรหัสผ่าน";
    var sent = ViewData["Sent"] is true;
}
<section class="auth-card card border-0 w-100 login-page" aria-labelledby="page-title">
    <figure class="auth-photo" aria-hidden="true"><img src="/images/hotels/th-stay-048.jpg" alt="" onerror="this.onerror=null;this.src='/images/stay/photo-pending.svg'" /></figure>
    <div class="auth-panel card-body">
        <div class="auth-brand-logo mb-3">
            <a asp-controller="Account" asp-action="Index" aria-label="Lodgo หน้าแรก"><img src="~/images/logo.png" alt="Lodgo" class="auth-logo" height="42" /></a>
        </div>
        <h1 id="page-title" class="mb-2">ลืมรหัสผ่าน</h1>
        @if (sent) {
            <div class="notice success" role="status">ถ้าอีเมลนี้มีบัญชีอยู่ ผู้ดูแลระบบได้รับคำขอแล้ว และจะติดต่อกลับพร้อมรหัสผ่านชั่วคราว ส่งคำขอได้ชั่วโมงละครั้ง</div>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">กลับไปหน้าเข้าสู่ระบบ</a>
        } else {
            <p class="page-intro mb-4">กรอกอีเมลที่ใช้สมัคร ระบบจะส่งคำขอถึงผู้ดูแลระบบ ผู้ดูแลจะตรวจตัวตนแล้วรีเซ็ตรหัสผ่านให้ (ระบบยังส่งอีเมลเองไม่ได้)</p>
            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="example@email.com" autocomplete="email" required aria-describedby="email-error" />
                    <span asp-validation-for="Email" id="email-error" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">ส่งคำขอรีเซ็ตรหัสผ่าน</button>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary w-100 mt-3">กลับไปหน้าเข้าสู่ระบบ</a>
            </form>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
