@model IReadOnlyList<Promotion>
@{Layout="_StayLayout";ViewData["Title"]="จัดการโปรโมชั่น";}
<section class="stay-container commerce-page"><partial name="_RoleNavigation" /><h1>จัดการโปรโมชั่น</h1><p class="lead-note">กำหนดโค้ด ส่วนลด และเงื่อนไข · ส่วนลดถูกคำนวณและบันทึกพร้อมการจอง</p><partial name="_CommerceMessage" /><a class="stay-button" asp-action="EditPromotion">+ เพิ่มประกาศ</a>
<div class="role-actions">@foreach(var p in Model){<article class="surface"><span class="pill">@(p.IsActive?"เปิดแสดงตามช่วงวันที่":"ปิดแสดง")</span><h2>@p.Title</h2><p class="promotion-copy">@p.Details</p>@if(p.Code is not null){<strong class="offer-code">@p.Code</strong><p>@p.Terms</p>}<small>@p.StartsOn.ToString("dd/MM/yyyy") – @p.EndsOn.ToString("dd/MM/yyyy")</small><div class="role-toolbar"><a class="stay-button secondary" asp-action="EditPromotion" asp-route-id="@p.Id">แก้ไข</a>@if(p.IsActive){<form asp-action="ArchivePromotion" method="post"><input name="id" value="@p.Id" type="hidden" /><button class="stay-button secondary" type="submit">ปิดประกาศ</button></form>}</div></article>}</div>@if(Model.Count==0){<p>ยังไม่มีประกาศโปรโมชั่น</p>}</section>