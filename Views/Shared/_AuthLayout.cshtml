<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <partial name="_AccountContext" />
    <title>@ViewData["Title"] · Lodgo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/stay.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/commerce.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/escape.css" asp-append-version="true" />
    <partial name="_ThemeHead" />
</head>
<body class="theme-editorial">
    <partial name="_WorkShell" />
    <partial name="_StayNavbar" />
    <main id="main-content" class="container auth-main d-flex align-items-center justify-content-center py-5">
        @RenderBody()
    </main>
    <partial name="_StayFooter" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/auth.js" asp-append-version="true" defer></script>
    <script src="~/js/stay.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/commerce.js" asp-append-version="true" defer></script>
</body>
</html>
